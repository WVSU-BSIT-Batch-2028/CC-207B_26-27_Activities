# Copy this file to ".env" and fill in your Firebase project credentials.
# Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup and configuration
# NOTE: src/firebase.js contains the same values as fallbacks, so the app also
# runs without a .env — a .env simply lets you switch projects without code edits.

VITE_FIREBASE_API_KEY=AIzaSyAwBcc9ZY01T1npIabaT9pRCU0bJEHDiZ0
VITE_FIREBASE_AUTH_DOMAIN=casssan.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=casssan
VITE_FIREBASE_STORAGE_BUCKET=casssan.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=226989661460
VITE_FIREBASE_APP_ID=1:226989661460:web:f29005ec17bad3eb463601

# ---------------------------------------------------------------------------
# BACKUP Firebase project (quota failover)
# ---------------------------------------------------------------------------
# A second Firebase project that mirrors the primary one. When the primary
# project's free daily quota (reads / writes / deletes) runs out, CASScan
# automatically switches all data traffic to this backup project until the
# quota resets (midnight Pacific Time). Create the backup project, enable
# Firestore + Email/Password auth there, then paste its web-app config below.
VITE_FIREBASE_BACKUP_API_KEY=AIzaSyD8sUvM5wCH38bSfxFhvYidCWRRzxPa0II
VITE_FIREBASE_BACKUP_AUTH_DOMAIN=casscanbackup.firebaseapp.com
VITE_FIREBASE_BACKUP_PROJECT_ID=casscanbackup
VITE_FIREBASE_BACKUP_STORAGE_BUCKET=casscanbackup.firebasestorage.app
VITE_FIREBASE_BACKUP_MESSAGING_SENDER_ID=953738490325
VITE_FIREBASE_BACKUP_APP_ID=1:953738490325:web:f961473c622564cc074d5c
